local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local Session = {
    Connections = {},
    Tags = {},
    InjectedSlots = {}
}
shared.MM2PriceOverlay = Session

function Session:Destroy()
    for _, c in pairs(self.Connections) do c:Disconnect() end
    for _, t in pairs(self.Tags) do 
        if t and t.Parent then t:Destroy() end 
    end
    if self.Loop then task.cancel(self.Loop) end
    self.Connections = {}
    self.Tags = {}
    self.InjectedSlots = {}
end

