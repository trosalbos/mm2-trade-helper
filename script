-- ПОЛУЧЕНИЕ ЗНАЧЕНИЯ ИЗ БАЗЫ
local function GetItemValue(slotFrame, cosmeticName)
    if not cosmeticName then return nil end
    local cleanNameLower = string.lower(string.match(cosmeticName, "^%s*(.-)%s*$"))
    
    local typeTag = ""
    local typeLabel = slotFrame:FindFirstChild("Type", true)
    if typeLabel and typeLabel:IsA("TextLabel") and typeLabel.Text ~= "" then
        typeTag = " (" .. string.lower(typeLabel.Text) .. ")" 
    end
    
    local isChroma = false
    local tagsFolder = slotFrame:FindFirstChild("Tags")
    if tagsFolder then
        local chromaTag = tagsFolder:FindFirstChild("Chroma")
        if chromaTag and chromaTag:IsA("GuiObject") and chromaTag.Visible then
            isChroma = true
        end
    end
    
    local rarityTag = ""
    local color = nil
    local itemNameObj = slotFrame:FindFirstChild("ItemName")
    if itemNameObj and itemNameObj:IsA("GuiObject") and itemNameObj.BackgroundTransparency < 1 then
        color = itemNameObj.BackgroundColor3
    else
        local bg = slotFrame:FindFirstChild("BG", true)
        if bg and bg:IsA("GuiObject") then
            color = bg:IsA("ImageLabel") and bg.ImageColor3 or bg.BackgroundColor3
        end
    end

    if color then
        local best, d1, d2 = nil, math.huge, math.huge
        for tier, ref in pairs(TIERS) do
            local d = dist2(color, ref)
            if d < d1 then best, d1, d2 = tier, d, d1
            elseif d < d2 then d2 = d end
        end
        if d1 < 0.15 and (d2 == 0 or d1 < d2 * 0.4) then
            rarityTag = " (" .. best .. ")"
        end
    end

    local variations = {}
    if isChroma then
        table.insert(variations, cleanNameLower .. " (chroma)" .. typeTag)
        table.insert(variations, cleanNameLower .. " (chroma)")
    end
    if rarityTag ~= "" then
        table.insert(variations, cleanNameLower .. rarityTag .. typeTag)
        table.insert(variations, cleanNameLower .. rarityTag)
    end
    if typeTag ~= "" then
        table.insert(variations, cleanNameLower .. typeTag)
    end
    table.insert(variations, cleanNameLower)

    for _, varName in ipairs(variations) do
        local result = Database[varName]
        if result then return result end
    end
    return nil
end

-- АНАЛИЗ ИНВЕНТАРЯ И ОТРИСОВКА
local function IsTradableCategory(guiObject)
    if guiObject:FindFirstAncestor("TradeGUI") then return true end
    if guiObject:FindFirstAncestor("Weapons") or guiObject:FindFirstAncestor("Pets") then return true end
    return false
end

local function GetSlotMultiplier(slotFrame)
    for _, child in ipairs(slotFrame:GetDescendants()) do
        if child:IsA("TextLabel") and child.Name ~= "PriceOverlayTag" and child.Visible and child.Text and child.Text ~= "" then
            local clean = string.gsub(child.Text, "<[^>]+>", "")
            clean = string.gsub(clean, "%s+", "")
            clean = string.lower(clean)
            local found = string.match(clean, "^x(%d+)$")
            if found then return tonumber(found) end
        end
    end
    return 1
end

local function ParseItemNameObj(slotFrame)
    local itemNameObj = slotFrame:FindFirstChild("ItemName")
    if itemNameObj then
        if itemNameObj:IsA("StringValue") then return itemNameObj.Value
        elseif itemNameObj:IsA("TextLabel") then return itemNameObj.Text
        elseif itemNameObj:IsA("GuiObject") then
            local label = itemNameObj:FindFirstChild("Label") or itemNameObj:FindFirstChild("TextLabel")
            if label and label:IsA("TextLabel") then return label.Text end
        end
    end
    return nil
end

-- ОСНОВНОЙ 4Hz ПОТОК (Вместо RenderStepped)
Session.Loop = task.spawn(function()
    while task.wait(0.25) do
        -- 1. ОБНОВЛЕНИЕ ТЕГОВ В ИНВЕНТАРЕ
        for i = #Session.InjectedSlots, 1, -1 do
            local entry = Session.InjectedSlots[i]
            if not entry.Slot or not entry.Slot.Parent then
                if entry.Tag then entry.Tag:Destroy() end
                table.remove(Session.InjectedSlots, i)
            else
                local name = ParseItemNameObj(entry.Slot)
                if name and name ~= "" and not name:match("^%s*$") then
                    local values = GetItemValue(entry.Slot, name)
                    if values == "!" then
                        entry.Tag.Text = '<font color="#FF0000"><b>❗️</b></font>'
                        entry.Tag.Visible = true
                    elseif type(values) == "table" then
                        local v2 = values[2] or 0
                        entry.Tag.Text = string.format('(<font color="#FFFF00">%s</font>)', tostring(v2))
                        entry.Tag.Visible = true
                    else
                        entry.Tag.Text = '<font color="#FF0000"><b>?</b></font>'
                        entry.Tag.Visible = true
                    end
                else
                    entry.Tag.Visible = false
                end
            end
        end

        -- 2. КАЛЬКУЛЯТОР ТРЕЙДА (Безопасно)
        local tradeGui = PlayerGui:FindFirstChild("TradeGUI")
        if tradeGui then
            local tradeSection = tradeGui:FindFirstChild("Container") and tradeGui.Container:FindFirstChild("Trade")
            if tradeSection then
                local function calcOffer(offerName)
                    local offer = tradeSection:FindFirstChild(offerName)
                    if not offer then return end
                    local container = offer:FindFirstChild("Container")
                    local title = offer:FindFirstChild("Title")
                    if not container or not title then return end
                    
                    local t2 = 0
                    local hasAmbig = false
                    for _, slot in ipairs(container:GetChildren()) do
                        if slot:IsA("GuiObject") and slot.Visible and slot:FindFirstChild("ItemName") then
                            local name = ParseItemNameObj(slot)
                            if name and name ~= "" and not name:match("^%s*$") then
                                local values = GetItemValue(slot, name)
                                if values == "!" then
                                    hasAmbig = true
                                elseif type(values) == "table" then
                                    local mult = GetSlotMultiplier(slot)
                                    t2 = t2 + ((values[2] or 0) * mult)
                                end
                            end
                        end
                    end
                    
                    title.RichText = true
                    local fmt = string.format('(<font color="#FFFF00">%.2f</font>)', t2):gsub("%.00", "")
                    if hasAmbig then fmt = fmt .. ' <font color="#FF0000">+❗️</font>' end
                    title.Text = fmt
                end
                calcOffer("YourOffer")
                calcOffer("TheirOffer")
            end
        end
    end
end)

-- ИНЪЕКЦИЯ ТЕГОВ
local function HookSlot(slotFrame)
    if not slotFrame:IsA("GuiObject") or not slotFrame:FindFirstChild("ItemName") then return end
    if not IsTradableCategory(slotFrame) then return end
    if slotFrame:GetAttribute("HasPriceOverlay") then return end
    slotFrame:SetAttribute("HasPriceOverlay", true)

    pcall(function()
        local priceLabel = Instance.new("TextLabel")
        priceLabel.Name = "PriceOverlayTag"
        priceLabel.Size = UDim2.new(1, 0, 0, 20)
        priceLabel.Position = UDim2.new(0, 0, 0, 2) 
        priceLabel.BackgroundTransparency = 1
        priceLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        priceLabel.TextStrokeTransparency = 1 
        priceLabel.TextSize = 18 
        priceLabel.Font = Enum.Font.SourceSansItalic 
        priceLabel.RichText = true 
        priceLabel.ZIndex = 20
        priceLabel.Parent = slotFrame

        table.insert(Session.Tags, priceLabel)
        table.insert(Session.InjectedSlots, {Slot = slotFrame, Tag = priceLabel})
    end)
end

local function WatchGUI(rootTarget)
    if not rootTarget then return end
    for _, desc in ipairs(rootTarget:GetDescendants()) do HookSlot(desc) end
    local conn = rootTarget.DescendantAdded:Connect(function(desc)
        task.defer(function() HookSlot(desc) end)
    end)
    table.insert(Session.Connections, conn)
end

local function Initialize()
    local tradeGui = PlayerGui:FindFirstChild("TradeGUI")
    if tradeGui then WatchGUI(tradeGui) end

    local mainGui = PlayerGui:FindFirstChild("MainGUI")
    if mainGui then
        local gameFolder = mainGui:FindFirstChild("Game")
        if gameFolder then
            if gameFolder:FindFirstChild("Inventory") then WatchGUI(gameFolder.Inventory) end
            if gameFolder:FindFirstChild("ViewProfile") then WatchGUI(gameFolder.ViewProfile) end
        end
    end
end

Initialize()
table.insert(Session.Connections, PlayerGui.ChildAdded:Connect(function(child)
    if child.Name == "MainGUI" or child.Name == "TradeGUI" then
        task.wait(1)
        Initialize()
    end
end))
