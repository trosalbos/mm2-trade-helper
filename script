-- АЛГОРИТМ REDMEAN ДЛЯ ТОЧНОГО ОПРЕДЕЛЕНИЯ ЦВЕТА
local function dist2(a, b)
    local rm = (a.R + b.R) / 2
    local dr, dg, db = a.R - b.R, a.G - b.G, a.B - b.B
    return (2 + rm) * dr * dr + 4 * dg * dg + (3 - rm) * db * db
end

